<Window x:Class="DVLD_Enterprise_System.UI.Views.SplashView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DVLD_Enterprise_System.UI.Views"
        mc:Ignorable="d"
        Title="SplashView" Height="450" Width="800" WindowStyle="None" ResizeMode="NoResize" 
        ShowInTaskbar="false" WindowStartupLocation="CenterScreen">
    <Grid Background="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center" >
        
        
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Height="293" Width="502">

            <TextBlock FontSize="28" FontWeight="Bold" Text="{Binding Title}" 
                       HorizontalAlignment="Center" Foreground="White"/>
            <TextBlock FontSize="16" Margin="0,10,0,0" Text="{Binding SubTitle}" HorizontalAlignment="Center" Foreground="White"/>
            <TextBlock FontSize="12" Margin="0,10,0,0" Text="{Binding StatusText}" HorizontalAlignment="Center" Foreground="White"/>
            <ProgressBar Height="31" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" 
                         Width="390">
            </ProgressBar>
            <TextBlock FontSize="14" Margin="0,10,0,0" Text="{Binding VersionText}" HorizontalAlignment="Center" Foreground="White"/>
            
        </StackPanel>


    </Grid>
</Window>
